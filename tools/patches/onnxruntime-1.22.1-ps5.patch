-// nftw() callback to remove a file
-int nftw_remove(
-    const char* fpath, const struct stat* /*sb*/,
-    int /*typeflag*/, struct FTW* /*ftwbuf*/) {
-  const auto result = remove(fpath);
-  if (result != 0) {
-    auto [err_no, err_msg] = GetErrnoInfo();
-    LOGS_DEFAULT(WARNING) << "remove() failed. Error code: " << err_no << " error msg: " << err_msg
-                          << ", path: " << fpath;
+// PS5's userland does not export nftw(), so walk without following symlinks.
+int RemoveFolderRecursively(const char* path) {
+  struct stat info {};
+  if (lstat(path, &info) != 0) {
+    return -1;
+  }
+  if (!S_ISDIR(info.st_mode)) {
+    return remove(path);
+  }
+  DIR* directory = opendir(path);
+  if (directory == nullptr) {
+    return -1;
+  }
+  int result = 0;
+  while (dirent* entry = readdir(directory)) {
+    if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) {
+      continue;
+    }
+    const std::string child = std::string(path) + "/" + entry->d_name;
+    struct stat child_info {};
+    if (lstat(child.c_str(), &child_info) != 0 ||
+        (S_ISDIR(child_info.st_mode) ? RemoveFolderRecursively(child.c_str()) : remove(child.c_str())) != 0) {
+      result = -1;
+      break;
+    }
+  }
+  const int close_result = closedir(directory);
+  if (result == 0 && close_result != 0) {
+    result = -1;
+  }
+  if (result == 0) {
+    result = rmdir(path);
   }
   return result;
 }
