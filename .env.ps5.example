# Copy to .env.ps5.local, fill the console address, then source tools/ps5-env.sh.
PS5_HOST=
# Required for test builds/deployments and benchmarks; never use the production title.
PROSPERO_TEST_TITLE=

PS5_PAYLOAD_PORT=9021
PS5_FTP_PORT=2120
PS5_AGENT_PORT=9111
PS5_SHADOW_PORT=10101
PS5_KLOG_PORT=3232
PS5_SHSRV_PORT=2323
FTP_PORT=2120

# Optional: P5 Manager runs on the development computer, not on the console.
# Example when installed locally: http://127.0.0.1:3001
P5_MANAGER=
# Needed only for Remote Play screenshots; obtain the active session from P5 Manager.
P5_SESSION=
