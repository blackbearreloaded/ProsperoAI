+    for (const Fallback &fallback : fallbacks_)
+    {
+        if (const ff::Glyph *glyph = fallback.face->find(*codepoint))
+            return {fallback.face, glyph, fallback.texture};
+    }
+    *codepoint = '?';
+    return {this, find('?'), 0};
